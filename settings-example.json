{
    "server": {
        "listen": "0.0.0.0",
        "port": 10003,
        "secret": "",
        "useSSL": false,
        "keyfile": "",
        "certfile": "",
        "cors_origins": [
            "http://localhost:8080"
        ]
    },
    "database": {
        "databasePath": "storageLeaf.db",
        "cleanup": {
            "retentionPolicies": [
                {
                    "numberOfMeasurementsPerDay": 24,
                    "ageInDays": 30
                },
                {
                    "numberOfMeasurementsPerDay": 2,
                    "ageInDays": 60
                }
            ],
            "automatic": {
                "enable": true,
                "cronSchedule": "0 0 * * 0"
            }
        }
    },
    "api": {
        "url": "http://localhost:10003",
        "key": ""
    },
    "discovery": {
        "discoveryPort": 9191,
        "responsePort": 9192,
        "requestMessage": "DISCOVER_STORAGELEAF_REQUEST",
        "responseMessage": "DISCOVER_STORAGELEAF_RESPONSE"
    }
}